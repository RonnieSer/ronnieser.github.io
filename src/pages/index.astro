---
import Layout from '../layouts/Layout.astro';
import ResearchCard from '../components/ResearchCard.astro';
import { page, selectedResearch, url } from '../lib/site';
const home = await page('home');
const entries = await selectedResearch();
---
<Layout active="Home">
  <h1 class="sr-only">{home.data.title}</h1>
  <section class="work-section" aria-labelledby="selected-title">
    <div class="section-heading page-top"><h2 id="selected-title">Selected research</h2><a class="small-link" href={url('research/')}>All research</a></div>
    {entries.length > 0 ? <div class="research-grid">{entries.map((entry) => <ResearchCard entry={entry} />)}</div> : <p class="empty-state">Research will appear here soon.</p>}
  </section>
</Layout>
